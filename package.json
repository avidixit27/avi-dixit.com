{
  "name": "photog-portfolio",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p cypress/tsconfig.json",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:unit:coverage": "vitest run --coverage",
    "test:component": "cypress run --component --browser chrome",
    "test:component:open": "cypress open --component",
    "test:e2e:run": "cypress run --e2e --browser chrome",
    "test:e2e": "npm run build && start-server-and-test preview:test http://127.0.0.1:4173 test:e2e:run",
    "preview": "vite preview",
    "preview:test": "vite preview --host 127.0.0.1 --port 4173",
    "check": "run-s lint format:check typecheck test:unit test:component test:e2e",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,mts}": [
      "eslint --report-unused-disable-directives --max-warnings 0",
      "prettier --check"
    ],
    "*.{css,html,json,md,mjs,yaml,yml}": "prettier --check"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.1.3"
  },
  "devDependencies": {
    "@cypress/react": "^10.0.0",
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.2.1",
    "@vitest/coverage-v8": "^2.1.9",
    "autoprefixer": "^10.4.20",
    "cypress": "^14.5.4",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "npm-run-all2": "^8.0.4",
    "postcss": "^8.5.1",
    "prettier": "^3.9.6",
    "start-server-and-test": "^3.0.12",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^5.0.8",
    "vitest": "^2.1.9"
  }
}

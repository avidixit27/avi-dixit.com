{
  "name": "avi-dixit",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.22.2 || ^24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:all-features": "vite --mode all-features",
    "build": "vite build",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p cypress/tsconfig.json",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:unit:coverage": "vitest run --coverage",
    "test:component": "node scripts/run-cypress-with-report.mjs --component --browser chrome",
    "test:component:reliability": "node scripts/repeat-component-reliability.mjs",
    "test:component:open": "cypress open --component",
    "test:e2e:run": "node scripts/run-cypress-with-report.mjs --e2e --browser chrome",
    "test:e2e": "npm run build && start-server-and-test preview:test http://127.0.0.1:4173 test:e2e:run",
    "test:all-features:run": "node scripts/run-cypress-with-report.mjs --e2e --browser chrome --spec cypress/e2e/all-features.cy.ts --config baseUrl=http://127.0.0.1:4174,specPattern=cypress/e2e/all-features.cy.ts",
    "test:all-features": "start-server-and-test 'npm run dev:all-features -- --host 127.0.0.1 --port 4174 --strictPort' http://127.0.0.1:4174 test:all-features:run",
    "security:audit": "npm audit --omit=dev --audit-level=moderate",
    "preview": "npm run build && wrangler dev",
    "preview:test": "vite preview --host 127.0.0.1 --port 4173",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run test:unit:coverage && npm run test:component && npm run test:e2e && npm run test:all-features",
    "prepare": "husky",
    "deploy": "npm run build && wrangler deploy"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --report-unused-disable-directives --max-warnings 0",
      "prettier --check"
    ],
    "*.{css,html,json,md,yaml,yml}": "prettier --check"
  },
  "dependencies": {
    "motion": "^13.2.0",
    "react": "^19.3.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.8",
    "@cypress/react": "^10.0.0",
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.0",
    "cypress": "^16.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.6",
    "start-server-and-test": "^3.0.12",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vite-imagetools": "^12.0.1",
    "vitest": "^5.0.0",
    "wrangler": "^4.131.1"
  }
}
